<?xml version="1.0"?>
<?xtml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>siranui</name>
  <version>0.0.0</version>
  <description>不知火ロボットの bringup パッケージ。シミュレータ(robot_sim)と選択式プランナーを起動する。</description>
  <maintainer email="arduino6110@gmail.com">ramune</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_sim</exec_depend>
  <exec_depend>pure_pursuit_planner</exec_depend>
  <exec_depend>stanley_planner</exec_depend>
  <exec_depend>mppi_planner</exec_depend>
  <exec_depend>a_star_planner</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>safety_limiter</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
