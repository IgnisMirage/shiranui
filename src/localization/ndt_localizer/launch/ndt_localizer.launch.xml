<launch>
  <!-- 3D 地図 PCD: 2D 地図 (map.yaml / map.png) と同じ autonomous_drive/map/ に置く -->
  <arg name="map_pcd_path"
       default="$(find-pkg-share autonomous_drive)/map/map.pcd"
       description="NDT ターゲット地図 (PCD, map 座標系)"/>

  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="input_topic" default="/mid360/points"/>
  <arg name="imu_topic" default="/mid360/imu"/>

  <!-- NDT 本体（屋外向け） -->
  <arg name="ndt_resolution" default="2.0" description="NDT ボクセルサイズ [m]"/>
  <arg name="ndt_step_size" default="0.1"/>
  <arg name="ndt_transformation_epsilon" default="0.01"/>
  <arg name="ndt_max_iterations" default="30"/>
  <arg name="ndt_num_threads" default="4"/>
  <!-- 0=KDTREE, 1=DIRECT7, 2=DIRECT1（速いがやや不安定） -->
  <arg name="ndt_search_method" default="1"/>

  <!-- 点群の前処理 -->
  <arg name="source_voxel_leaf_size" default="0.5" description="スキャンのダウンサンプリング [m]"/>
  <arg name="map_voxel_leaf_size" default="0.5" description="地図のダウンサンプリング [m]"/>
  <arg name="min_scan_range" default="1.0" description="これより近い点（車体など）を除外 [m]"/>
  <arg name="max_scan_range" default="40.0" description="これより遠い点を除外 [m]"/>
  <arg name="min_height" default="-2.0" description="base_link 基準の高さ下限 [m]"/>
  <arg name="max_height" default="4.0" description="base_link 基準の高さ上限（樹冠などを除外）[m]"/>
  <arg name="deskew" default="true" description="走行中の点群の歪み補正"/>
  <arg name="deskew_use_imu" default="true" description="歪み補正の回転に IMU のジャイロを使う"/>
  <arg name="scan_accumulation_count" default="3" description="オドメで位置合わせして重ねるフレーム数 (1=蓄積なし)"/>

  <!-- 結果の採否判定 -->
  <arg name="nvtl_threshold" default="2.3" description="NVTL がこれ未満なら棄却（~/nvtl を見て調整）"/>
  <arg name="max_translation_jump" default="1.0" description="オドメ予測からの許容ずれ [m]"/>
  <arg name="max_yaw_jump_deg" default="10.0" description="オドメ予測からの許容ずれ [deg]"/>

  <arg name="publish_tf" default="true" description="TF map -> odom を配信する"/>
  <arg name="pose_topic" default="ndt_pose"/>
  <arg name="odom_topic" default="localization_odom"/>

  <node pkg="ndt_localizer" exec="ndt_localizer_node" name="ndt_localizer" output="screen">
    <param name="map_pcd_path" value="$(var map_pcd_path)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="odom_frame" value="$(var odom_frame)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="input_topic" value="$(var input_topic)"/>
    <param name="imu_topic" value="$(var imu_topic)"/>

    <param name="ndt_resolution" value="$(var ndt_resolution)"/>
    <param name="ndt_step_size" value="$(var ndt_step_size)"/>
    <param name="ndt_transformation_epsilon" value="$(var ndt_transformation_epsilon)"/>
    <param name="ndt_max_iterations" value="$(var ndt_max_iterations)"/>
    <param name="ndt_num_threads" value="$(var ndt_num_threads)"/>
    <param name="ndt_search_method" value="$(var ndt_search_method)"/>

    <param name="source_voxel_leaf_size" value="$(var source_voxel_leaf_size)"/>
    <param name="map_voxel_leaf_size" value="$(var map_voxel_leaf_size)"/>
    <param name="min_scan_range" value="$(var min_scan_range)"/>
    <param name="max_scan_range" value="$(var max_scan_range)"/>
    <param name="min_height" value="$(var min_height)"/>
    <param name="max_height" value="$(var max_height)"/>
    <param name="deskew" value="$(var deskew)"/>
    <param name="deskew_use_imu" value="$(var deskew_use_imu)"/>
    <param name="scan_accumulation_count" value="$(var scan_accumulation_count)"/>

    <param name="nvtl_threshold" value="$(var nvtl_threshold)"/>
    <param name="max_translation_jump" value="$(var max_translation_jump)"/>
    <param name="max_yaw_jump_deg" value="$(var max_yaw_jump_deg)"/>

    <param name="publish_tf" value="$(var publish_tf)"/>
    <param name="pose_topic" value="$(var pose_topic)"/>
    <param name="odom_topic" value="$(var odom_topic)"/>
  </node>
</launch>
