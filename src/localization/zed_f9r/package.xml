<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zed_f9r</name>
  <version>0.0.0</version>
  <description>ROS 2 UBX driver for u-blox ZED-F9R using the SparkFun sparkfun-ublox-gps library</description>
  <maintainer email="k-yoshida@industryalpha.net">yoshida</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- sparkfun-ublox-gps と spidev は rosdep に無いので pip で入れる。README を参照 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
