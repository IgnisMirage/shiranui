<launch>
  <arg name="planner" default="pure_pursuit"
       description="使用するプランナーを選択 (pure_pursuit / stanley / mppi)">
    <choice value="pure_pursuit"/>
    <choice value="stanley"/>
    <choice value="mppi"/>
  </arg>

  <arg name="foxglove" default="true" description="Foxglove Bridge を起動するか (true/false)"/>
  <arg name="foxglove_port" default="8765" description="Foxglove Bridge の待ち受けポート"/>

  <arg name="a_star" default="true" description="A* グローバルプランナーを起動するか (true/false)"/>

  <arg name="map" default="true" description="map_publisher で地図を配信するか (true/false)"/>
  <arg name="safety_limiter" default="true" description="安全監視ノードを起動するか (true/false)"/>
  <arg name="map_yaml" default="$(find-pkg-share autonomous_drive)/map/map.yaml"
       description="読み込む地図の yaml ファイル"/>

  <arg name="odrive_can_driver" default="true" description="ODrive CAN Driver を起動するか (true/false)"/>
  <arg name="can_interface" default="can0" description="CAN interface name"/>
  <arg name="left_wheel_node_id" default="1" description="Left wheel ODrive node ID"/>
  <arg name="right_wheel_node_id" default="2" description="Right wheel ODrive node ID"/>

  <arg name="tg15_driver" default="true" description="TG15 (2D LiDAR) Driver を起動するか (true/false)"/>
  <arg name="tg15_port" default="/dev/ttyUSB0" description="TG15 のシリアルポート"/>
  <arg name="tg15_frame_id" default="laser_frame" description="TG15 の LaserScan フレーム ID"/>

  <arg name="mid360_driver" default="true" description="Livox Mid-360 (3D LiDAR) Driver を起動するか (true/false)"/>
  <arg name="mid360_host_ip" default="192.168.1.15" description="Mid-360 との通信に使うホスト側 IP"/>
  <arg name="mid360_lidar_ip" default="192.168.1.125" description="Mid-360 本体の IP"/>
  <arg name="mid360_points_topic" default="/mid360/points" description="Mid-360 の PointCloud2 出力トピック"/>
  <arg name="mid360_packet_topic" default="/mid360/packet" description="Mid-360 の生パケット出力トピック"/>
  <arg name="mid360_imu_topic" default="/mid360/imu" description="Mid-360 の IMU 出力トピック"/>

  <arg name="joy" default="true" description="ジョイスティック入力 (joy_node / joy_translate) を起動するか (true/false)"/>
  <arg name="joy_device_id" default="0" description="使用するジョイスティックのデバイス ID"/>
  <arg name="joy_deadzone" default="0.05" description="joy_node のデッドゾーン"/>

  <include file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml"
           if="$(var foxglove)">
    <arg name="port" value="$(var foxglove_port)"/>
  </include>

  <include file="$(find-pkg-share odrive_can_driver)/launch/odrive_can_driver.launch.xml"
           if="$(var odrive_can_driver)">
    <arg name="can_interface" value="$(var can_interface)"/>
    <arg name="left_wheel_node_id" value="$(var left_wheel_node_id)"/>
    <arg name="right_wheel_node_id" value="$(var right_wheel_node_id)"/>
  </include>

  <include file="$(find-pkg-share tg15_driver)/launch/tg15_driver.launch.xml"
           if="$(var tg15_driver)">
    <arg name="port" value="$(var tg15_port)"/>
    <arg name="frame_id" value="$(var tg15_frame_id)"/>
  </include>

  <include file="$(find-pkg-share mid360_driver)/launch/mid360.launch.xml"
           if="$(var mid360_driver)">
    <arg name="host_ip" value="$(var mid360_host_ip)"/>
    <arg name="lidar_ip" value="$(var mid360_lidar_ip)"/>
    <arg name="points_topic" value="$(var mid360_points_topic)"/>
    <arg name="packet_topic" value="$(var mid360_packet_topic)"/>
    <arg name="imu_topic" value="$(var mid360_imu_topic)"/>
  </include>

  <node pkg="joy" exec="joy_node" name="joy_node" output="screen" if="$(var joy)">
    <param name="device_id" value="$(var joy_device_id)"/>
    <param name="deadzone" value="$(var joy_deadzone)"/>
  </node>

  <node pkg="joy_translate" exec="joy_translate_node" name="joy_translate" output="screen"
        if="$(var joy)"/>

  <node pkg="safety_limiter" exec="safety_limiter" name="safety_limiter" output="screen"
        if="$(var safety_limiter)">
    <param from="$(find-pkg-share safety_limiter)/config/safety_limiter_params.yaml"/>
    <remap from="cloud" to="cloud"/>
    <remap from="footprint" to="footprint"/>
  </node>

  <node pkg="autonomous_drive" exec="map_publisher_node" name="map_publisher" output="screen"
        if="$(var map)">
    <param name="map_yaml" value="$(var map_yaml)"/>
    <param name="topic_name" value="map"/>
    <param name="frame_id" value="map"/>
    <param name="publish_rate" value="1.0"/>
  </node>

  <node pkg="a_star_planner" exec="a_star_component" name="a_star_planner_node"
        output="screen" if="$(var a_star)">
    <param from="$(find-pkg-share a_star_planner)/config/planner_params.yaml"/>
    <param name="use_sim_time" value="false"/>
  </node>

  <node pkg="pure_pursuit_planner" exec="pure_pursuit_planner_node" name="pure_pursuit_planner"
        output="screen"
        if="$(eval '&quot;$(var planner)&quot; == &quot;pure_pursuit&quot; and &quot;$(var safety_limiter)&quot; == &quot;true&quot;')">
    <param from="$(find-pkg-share pure_pursuit_planner)/config/pure_pursuit_params.yaml"/>
    <remap from="/auto_cmd_vel" to="/cmd_vel_in"/>
  </node>

  <node pkg="pure_pursuit_planner" exec="pure_pursuit_planner_node" name="pure_pursuit_planner_direct"
        output="screen"
        if="$(eval '&quot;$(var planner)&quot; == &quot;pure_pursuit&quot; and &quot;$(var safety_limiter)&quot; == &quot;false&quot;')">
    <param from="$(find-pkg-share pure_pursuit_planner)/config/pure_pursuit_params.yaml"/>
    <remap from="/auto_cmd_vel" to="/cmd_vel"/>
  </node>

  <node pkg="stanley_planner" exec="stanley_planner_node" name="stanley_planner"
        output="screen"
        if="$(eval '&quot;$(var planner)&quot; == &quot;stanley&quot; and &quot;$(var safety_limiter)&quot; == &quot;true&quot;')">
    <param from="$(find-pkg-share stanley_planner)/config/stanley_params.yaml"/>
    <remap from="/auto_cmd_vel" to="/cmd_vel_in"/>
  </node>

  <node pkg="stanley_planner" exec="stanley_planner_node" name="stanley_planner_direct"
        output="screen"
        if="$(eval '&quot;$(var planner)&quot; == &quot;stanley&quot; and &quot;$(var safety_limiter)&quot; == &quot;false&quot;')">
    <param from="$(find-pkg-share stanley_planner)/config/stanley_params.yaml"/>
    <remap from="/auto_cmd_vel" to="/cmd_vel"/>
  </node>

  <node pkg="mppi_planner" exec="mppi_node" name="mppi_planner"
        output="screen" if="$(equals $(var planner) mppi)"/>
</launch>
