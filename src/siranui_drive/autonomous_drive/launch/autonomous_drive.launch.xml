<launch>
  <arg name="planner" default="pure_pursuit"
       description="使用するプランナーを選択 (pure_pursuit / stanley / mppi)">
    <choice value="pure_pursuit"/>
    <choice value="stanley"/>
    <choice value="mppi"/>
  </arg>

  <arg name="foxglove" default="true" description="Foxglove Bridge を起動するか (true/false)"/>
  <arg name="foxglove_port" default="8765" description="Foxglove Bridge の待ち受けポート"/>

  <arg name="map" default="true" description="/map (2D 占有格子) を配信するか (true/false)"/>
  <arg name="map_yaml" default="$(find-pkg-share autonomous_drive)/map/map.yaml"
       description="2D 占有格子 (map.pcd から scripts/pcd_to_map.py で生成)"/>
  <arg name="map_pcd_path" default="$(find-pkg-share autonomous_drive)/map/map.pcd"
       description="3D 地図 PCD (ndt_omp の位置推定用)"/>

  <arg name="can_interface" default="can0" description="CAN interface name"/>
  <arg name="left_wheel_node_id" default="1" description="Left wheel ODrive node ID"/>
  <arg name="right_wheel_node_id" default="2" description="Right wheel ODrive node ID"/>
  <arg name="left_wheel_sign" default="-1.0" description="左車輪の回転方向 (+1/-1)"/>
  <arg name="right_wheel_sign" default="1.0" description="右車輪の回転方向 (+1/-1)"/>

  <arg name="tg15_driver" default="false"
       description="TG15 (2D LiDAR) Driver を起動するか (true/false)。false のときは Mid-360 の点群から /scan を作る"/>
  <arg name="tg15_port" default="/dev/ttyAMA10" description="TG15 のシリアルポート"/>
  <arg name="tg15_frame_id" default="laser_frame" description="TG15 の LaserScan フレーム ID"/>

  <arg name="mid360_host_ip" default="192.168.1.15" description="Mid-360 との通信に使うホスト側 IP"/>
  <arg name="mid360_lidar_ip" default="192.168.1.125" description="Mid-360 本体の IP"/>
  <arg name="mid360_points_topic" default="/mid360/points" description="Mid-360 の PointCloud2 出力トピック"/>
  <arg name="mid360_packet_topic" default="/mid360/packet" description="Mid-360 の生パケット出力トピック"/>
  <arg name="mid360_imu_topic" default="/mid360/imu" description="Mid-360 の IMU 出力トピック"/>

  <!-- Mid-360 の点群から /scan を作るときの切り出し範囲（base_link 基準） -->
  <arg name="scan_min_height" default="0.1" description="/scan に使う点の高さ下限 [m]（地面を除外）"/>
  <arg name="scan_max_height" default="1.0" description="/scan に使う点の高さ上限 [m]"/>
  <arg name="scan_range_min" default="0.4" description="これより近い点（車体）を除外 [m]"/>
  <arg name="scan_range_max" default="20.0" description="これより遠い点を除外 [m]"/>

  <arg name="joy_device_id" default="0" description="使用するジョイスティックのデバイス ID"/>
  <arg name="joy_deadzone" default="0.05" description="joy_node のデッドゾーン"/>
  <arg name="joy_max_linear_velocity" default="0.5" description="手動操縦の最大線速度 [m/s]"/>
  <arg name="joy_max_angular_velocity" default="0.7" description="手動操縦の最大角速度 [rad/s]"/>

  <arg name="transforms_file" default="$(find-pkg-share tf_publisher)/config/transforms.yaml"
       description="TF の定義ファイル"/>

  <include file="$(find-pkg-share tf_publisher)/launch/tf_publisher.launch.xml">
    <arg name="transforms_file" value="$(var transforms_file)"/>
  </include>

  <include file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml"
           if="$(var foxglove)">
    <arg name="port" value="$(var foxglove_port)"/>
  </include>

  <include file="$(find-pkg-share odrive_can_driver)/launch/odrive_can_driver.launch.xml">
    <arg name="can_interface" value="$(var can_interface)"/>
    <arg name="left_wheel_node_id" value="$(var left_wheel_node_id)"/>
    <arg name="right_wheel_node_id" value="$(var right_wheel_node_id)"/>
    <arg name="left_wheel_sign" value="$(var left_wheel_sign)"/>
    <arg name="right_wheel_sign" value="$(var right_wheel_sign)"/>
  </include>

  <include file="$(find-pkg-share tg15_driver)/launch/tg15_driver.launch.xml"
           if="$(var tg15_driver)">
    <arg name="port" value="$(var tg15_port)"/>
    <arg name="frame_id" value="$(var tg15_frame_id)"/>
  </include>

  <include file="$(find-pkg-share mid360_driver)/launch/mid360.launch.xml">
    <arg name="host_ip" value="$(var mid360_host_ip)"/>
    <arg name="lidar_ip" value="$(var mid360_lidar_ip)"/>
    <arg name="points_topic" value="$(var mid360_points_topic)"/>
    <arg name="packet_topic" value="$(var mid360_packet_topic)"/>
    <arg name="imu_topic" value="$(var mid360_imu_topic)"/>
  </include>

  <include file="$(find-pkg-share ndt_omp)/launch/ndt_omp.launch.xml">
    <arg name="map_pcd_path" value="$(var map_pcd_path)"/>
    <arg name="points_topic" value="$(var mid360_points_topic)"/>
  </include>

  <node pkg="pointcloud_to_laserscan" exec="pointcloud_to_laserscan_node"
        name="pointcloud_to_laserscan" output="screen" unless="$(var tg15_driver)">
    <param name="target_frame" value="base_link"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="$(var scan_min_height)"/>
    <param name="max_height" value="$(var scan_max_height)"/>
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.0087"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="$(var scan_range_min)"/>
    <param name="range_max" value="$(var scan_range_max)"/>
    <param name="use_inf" value="true"/>
    <remap from="cloud_in" to="$(var mid360_points_topic)"/>
    <remap from="scan" to="scan"/>
  </node>

  <!-- /scan (TG15 または Mid-360 由来) を safety_limiter 用の cloud に変換 -->
  <node pkg="pointcloud_to_laserscan" exec="laserscan_to_pointcloud_node"
        name="laserscan_to_pointcloud" output="screen">
    <param from="$(find-pkg-share autonomous_drive)/config/scan_to_pointcloud_params.yaml"/>
    <remap from="scan_in" to="scan"/>
    <remap from="cloud" to="cloud"/>
  </node>

  <node pkg="robot_sim" exec="footprint_publisher_node" name="footprint_publisher" output="screen">
    <param from="$(find-pkg-share autonomous_drive)/config/footprint_params.yaml"/>
  </node>

  <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <param name="device_id" value="$(var joy_device_id)"/>
    <param name="deadzone" value="$(var joy_deadzone)"/>
  </node>

  <node pkg="joy_translate" exec="joy_translate_node" name="joy_translate" output="screen">
    <param name="max_linear_velocity" value="$(var joy_max_linear_velocity)"/>
    <param name="max_angular_velocity" value="$(var joy_max_angular_velocity)"/>
  </node>

  <!-- RB=manual / start=auto で /manual_cmd_vel と /auto_cmd_vel のどちらかを選んで /cmd_vel_in に出す。
       safety_limiter が手動・自動どちらも軌道予測して /cmd_vel に流す -->
  <node pkg="drive_mode_switch" exec="drive_mode_switch_node" name="drive_mode_switch" output="screen">
    <remap from="cmd_vel" to="cmd_vel_in"/>
  </node>

  <node pkg="safety_limiter" exec="safety_limiter" name="safety_limiter" output="screen">
    <param from="$(find-pkg-share safety_limiter)/config/safety_limiter_params.yaml"/>
    <param name="cmd_vel_in_topic" value="cmd_vel_in"/>
    <param name="cmd_vel_out_topic" value="cmd_vel"/>
  </node>

  <node pkg="autonomous_drive" exec="map_publisher_node" name="map_publisher" output="screen"
        if="$(var map)">
    <param name="map_yaml" value="$(var map_yaml)"/>
    <param name="topic_name" value="map"/>
    <param name="frame_id" value="map"/>
    <param name="publish_rate" value="1.0"/>
  </node>

  <!-- global planner -->
  <node pkg="a_star_planner" exec="a_star_component" name="a_star_planner_node"
        output="screen">
    <param from="$(find-pkg-share a_star_planner)/config/planner_params.yaml"/>
    <param name="use_sim_time" value="false"/>
    <param name="map_topic" value="map"/>
  </node>

  <!-- local planner -->
  <node pkg="pure_pursuit_planner" exec="pure_pursuit_planner_node" name="pure_pursuit_planner"
        output="screen" if="$(equals $(var planner) pure_pursuit)">
    <param from="$(find-pkg-share pure_pursuit_planner)/config/pure_pursuit_params.yaml"/>
  </node>

  <node pkg="stanley_planner" exec="stanley_planner_node" name="stanley_planner"
        output="screen" if="$(equals $(var planner) stanley)">
    <param from="$(find-pkg-share stanley_planner)/config/stanley_params.yaml"/>
  </node>

  <node pkg="mppi_planner" exec="mppi_node" name="mppi_planner"
        output="screen" if="$(equals $(var planner) mppi)">
    <remap from="cmd_vel" to="auto_cmd_vel"/>
  </node>
</launch>
